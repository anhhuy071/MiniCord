{
  "name": "ecc-harness-template",
  "version": "2.0.0",
  "private": true,
  "description": "ECC Cursor harness template with agent observability",
  "scripts": {
    "harness:audit": "node scripts/harness-audit.js",
    "harness:bootstrap": "node scripts/harness-bootstrap.js",
    "observability:ready": "node scripts/observability-readiness.js",
    "observability:inspect": "node scripts/session-inspect.js --live --json",
    "orchestration:status": "node scripts/orchestration-status.js --list",
    "orchestration:worktrees": "node scripts/orchestrate-worktrees.js",
    "eval:check": "node scripts/eval-runner.js check",
    "eval:report": "node scripts/eval-runner.js report",
    "observability:export": "node scripts/telemetry-exporter.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "optionalDependencies": {
    "@iarna/toml": "^2.2.5",
    "ajv": "^8.17.1",
    "sql.js": "^1.12.0"
  }
}
